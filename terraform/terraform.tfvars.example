# Copy to terraform.tfvars (gitignored) and fill in your values.
# For GitHub Actions, store the same content in the TF_VARS_CONTENT secret.

aws_region                = "us-east-1"
profile                   = "default"
vpc_cidr                  = "10.0.0.0/16"
public_web_subnet_1_cidr  = "10.0.1.0/24"
public_web_subnet_2_cidr  = "10.0.2.0/24"
private_app_subnet_1_cidr = "10.0.3.0/24"
private_app_subnet_2_cidr = "10.0.4.0/24"
private_db_subnet_1_cidr  = "10.0.5.0/24"
private_db_subnet_2_cidr  = "10.0.6.0/24"

# Restrict SSH (bastion) to your IP, e.g. "203.0.113.10/32"
ssh_locate = "0.0.0.0/0"

db_username         = "admin"
db_instance_class   = "db.t3.micro"
multi_az_deployment = true

# Must be globally unique
s3_bucket_name = "your-unique-app-bucket-name"

# Used for SNS / security notifications
notification_email = "you@example.com"
